# 복사해서 .env 로 저장한다(.env 는 Git 에서 제외됨). 실제 비밀번호는 이 파일에 쓰지 않는다.
# 다른 애플리케이션과 DB 를 같이 쓰면 전용 스키마를 지정한다: ...?options=-csearch_path%3Dworkbench
WORKBENCH_PG_DSN=postgresql://workbench@127.0.0.1:5432/workbench
# 비밀번호는 DSN 에 넣지 말고 여기(또는 %APPDATA%\postgresql\pgpass.conf)에 둔다.
PGPASSWORD=

# 웹 UI(workbench web, 선택 기능 — pip install -e '.[web]' 필요)에만 쓴다. 둘 다 비어 있으면 서버가
# 시작을 거부한다(기본 거부). 실제 값은 무작위로 새로 만들어서 쓰고 이 파일에는 쓰지 않는다.
WORKBENCH_WEB_USER=operator
WORKBENCH_WEB_PASSWORD=
WORKBENCH_WEB_SECRET=
# web/ 프론트엔드(Next.js)가 아닌 다른 origin 에서 접속할 때만 바꾼다(기본 http://localhost:3000).
WORKBENCH_WEB_ORIGINS=http://localhost:3000
