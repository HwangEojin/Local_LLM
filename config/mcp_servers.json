{
  "servers": {
    "burp": {
      "enabled": true,
      "description": "Burp Suite MCP (PortSwigger 'MCP Server' 확장). Burp 를 실행하고 확장의 서버 주소를 확인해 url 을 맞출 것. 결과는 진단 범위 안의 요청만 증거로 저장한다(scope_filter). 프록시 이력 등은 Burp 화면에서 사용자 승인이 필요할 수 있어 timeout_s 를 길게 둔다.",
      "transport": "sse",
      "url": "http://127.0.0.1:9876/",
      "timeout_s": 180,
      "allowed_tools": {
        "get_proxy_http_history": {
          "risk": "read",
          "scope_filter": "burp",
          "args_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "offset"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "get_proxy_http_history_regex": {
          "risk": "read",
          "scope_filter": "burp",
          "args_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "offset",
              "regex"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "regex": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        },
        "get_organizer_items": {
          "risk": "read",
          "scope_filter": "burp",
          "args_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "offset"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "get_scanner_issues": {
          "risk": "read",
          "scope_filter": "burp",
          "args_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "offset"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "send_http1_request": {
          "risk": "write",
          "scope_args": {
            "targetHostname": "host"
          }
        }
      }
    },
    "ghidra": {
      "enabled": false,
      "description": "[템플릿] 이 PC 에 맞는 command/args 를 config/mcp_servers.local.json 에 같은 서버 이름으로 작성하고 enabled 를 true 로 둔다 (그 파일은 Git 에 올라가지 않는다). GhidraMCP 브리지(stdio). Ghidra 에서 분석할 프로그램을 열고 GhidraMCP 플러그인(http://127.0.0.1:8091/)을 켜 둬야 호출이 성공한다. 도구는 열려 있는 프로그램에 작용하므로 어떤 바이너리가 열렸는지는 scope 로 검증할 수 없다(운영자 책임). rename_/set_ 도구는 Ghidra 프로젝트를 수정하므로 write.",
