{
  "checklist_id": "sample-local-config",
  "guide_name": "SAMPLE — 테스트용 예시 체크리스트 (공식 가이드 아님)",
  "guide_version": "0.1.0-sample",
  "official": false,
  "notice": "이 체크리스트는 엔진 동작 검증을 위한 테스트용 예시이며 어떤 공식 기관의 진단 가이드도 아니다. 판정 기준과 조치 권고는 예시로 작성되었으므로 실제 진단 기준으로 사용하지 말 것.",
  "items": [
    {
      "check_id": "SAMPLE-001",
      "title": "설정 파일 내 평문 비밀번호 기재 여부 (예시)",
      "item_status": "complete",
      "source_reference": "없음 — 테스트용 예시 항목",
      "target_types": ["path"],
      "applicability": "app.conf 설정 파일이 있는 경로 대상",
      "procedure": "대상 경로의 app.conf 를 읽어 password/passwd 키에 값이 평문으로 기재되어 있는지 확인한다.",
      "pass_criteria": "password 계열 키에 평문 값이 없다.",
      "fail_criteria": "password 계열 키에 평문 값이 존재한다.",
      "evidence_requirements": [
        {"id": "app_conf", "description": "app.conf 원문", "tool": "fs.read_file", "args": {"path": "{target}/app.conf"}}
      ],
      "verification_method": {
        "type": "rule",
        "rule": {"kind": "regex", "evidence": "app_conf", "pattern": "(?im)^\\s*\\w*pass(?:word|wd)\\w*\\s*=\\s*\\S+", "fail_if": "match"}
      },
      "remediation": "(예시) 비밀번호를 설정 파일에서 제거하고 별도의 비밀 저장소를 사용한다.",
      "severity": "high",
      "rule_version": "1"
    },
    {
      "check_id": "SAMPLE-002",
      "title": "디버그 모드 활성화 여부 (예시)",
      "item_status": "complete",
      "source_reference": "없음 — 테스트용 예시 항목",
      "target_types": ["path"],
      "applicability": "app.conf 설정 파일이 있는 경로 대상",
      "procedure": "app.conf 에서 debug = true 설정이 있는지 확인한다.",
      "pass_criteria": "debug = true 설정이 없다.",
      "fail_criteria": "debug = true 설정이 있다.",
      "evidence_requirements": [
        {"id": "app_conf", "description": "app.conf 원문", "tool": "fs.read_file", "args": {"path": "{target}/app.conf"}}
      ],
      "verification_method": {
        "type": "rule",
        "rule": {"kind": "regex", "evidence": "app_conf", "pattern": "(?im)^\\s*debug\\s*=\\s*true\\b", "fail_if": "match"}
      },
      "remediation": "(예시) 운영 환경에서는 debug = false 로 설정한다.",
      "severity": "medium",
      "rule_version": "1"
    },
    {
      "check_id": "SAMPLE-003",
      "title": "TLS 활성화 설정 존재 여부 (예시)",
      "item_status": "complete",
      "source_reference": "없음 — 테스트용 예시 항목",
      "target_types": ["path"],
      "applicability": "app.conf 설정 파일이 있는 경로 대상",
      "procedure": "app.conf 에 tls_enabled = true 설정이 명시되어 있는지 확인한다.",
      "pass_criteria": "tls_enabled = true 가 명시되어 있다.",
      "fail_criteria": "tls_enabled = true 가 없다.",
      "evidence_requirements": [
        {"id": "app_conf", "description": "app.conf 원문", "tool": "fs.read_file", "args": {"path": "{target}/app.conf"}}
      ],
      "verification_method": {
        "type": "rule",
        "rule": {"kind": "regex", "evidence": "app_conf", "pattern": "(?im)^\\s*tls_enabled\\s*=\\s*true\\b", "fail_if": "no_match"}
      },
      "remediation": "(예시) tls_enabled = true 를 설정한다.",
      "severity": "medium",
      "rule_version": "1"
    },
